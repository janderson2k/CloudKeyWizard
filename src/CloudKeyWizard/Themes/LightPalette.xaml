<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Not just DarkPalette's colors inverted - contrast-checked separately, since a straight
         invert tends to produce muddy or harsh results. AccentBlue/DangerRed/CautionYellow are all
         deepened from their dark-mode values because the same bright colors that read fine on a
         near-black background lose contrast (or turn harsh/glary) on white. TerminalBg matches
         DarkPalette's value on purpose - see the comment there. -->
    <SolidColorBrush x:Key="BgWindow" Color="#F4F4F6"/>
    <SolidColorBrush x:Key="BgPanel" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="BgPanelAlt" Color="#E9E9EE"/>
    <SolidColorBrush x:Key="BgInput" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="BorderSubtle" Color="#D3D3D9"/>
    <SolidColorBrush x:Key="TextPrimary" Color="#1B1B1D"/>
    <SolidColorBrush x:Key="TextSecondary" Color="#5F5F66"/>
    <SolidColorBrush x:Key="AccentBlue" Color="#1E67C6"/>
    <SolidColorBrush x:Key="DangerRed" Color="#C22F2F"/>
    <SolidColorBrush x:Key="CautionYellow" Color="#9C6B0A"/>
    <SolidColorBrush x:Key="TerminalBg" Color="#0B0B0C"/>
</ResourceDictionary>
