<Application x:Class="CloudKeyWizard.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:CloudKeyWizard"
             xmlns:conv="clr-namespace:CloudKeyWizard.Converters"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Default theme. ViewModels/MainViewModel.ToggleThemeCommand swaps this entry at
                     runtime (index 0) for Themes/LightPalette.xaml - every color reference in this
                     app uses DynamicResource specifically so that swap propagates without needing to
                     touch any binding by hand. -->
                <ResourceDictionary Source="Themes/DarkPalette.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- ================= Converters ================= -->
            <conv:StatusToGlyphConverter x:Key="StatusToGlyph"/>
            <conv:StatusToBrushConverter x:Key="StatusToBrush"/>
            <conv:SeverityToBrushConverter x:Key="SeverityToBrush"/>
            <conv:SeverityToLabelConverter x:Key="SeverityToLabel"/>
            <conv:TerminalKindToBrushConverter x:Key="TerminalKindToBrush"/>
            <conv:StringEqualsToVisibilityConverter x:Key="StringEqualsToVisibility"/>
            <conv:InverseBoolConverter x:Key="InverseBool"/>
            <conv:BoolToVisibilityConverter x:Key="BoolToVisibility"/>
            <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility"/>
            <conv:NullToVisibilityConverter x:Key="NullToVisibility"/>
            <conv:StringHasValueToVisibilityConverter x:Key="StringHasValueToVisibility"/>
            <conv:StringEmptyToVisibilityConverter x:Key="StringEmptyToVisibility"/>
            <conv:SeverityIsWarningToVisibilityConverter x:Key="SeverityIsWarningToVisibility"/>
            <conv:BoolToStatusDotBrushConverter x:Key="BoolToStatusDotBrush"/>
            <conv:DeviceRiskToBrushConverter x:Key="DeviceRiskToBrush"/>
            <conv:StringEqualsToBoolConverter x:Key="StringEqualsToBool"/>
            <conv:IntGreaterThanZeroToVisibilityConverter x:Key="IntGreaterThanZeroToVisibility"/>
            <conv:OutcomeVerdictToBrushConverter x:Key="OutcomeVerdictToBrush"/>
            <conv:OutcomeVerdictToLabelConverter x:Key="OutcomeVerdictToLabel"/>

            <!-- ================= Base styles ================= -->
            <!-- Palette brushes (BgWindow, BgPanel, TextPrimary, AccentBlue, DangerRed, etc.) now
                 come from the merged theme dictionary above, not defined here - see
                 Themes/DarkPalette.xaml and Themes/LightPalette.xaml. -->
            <Style TargetType="Window">
                <Setter Property="Background" Value="{DynamicResource BgWindow}"/>
                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                <Setter Property="FontFamily" Value="Segoe UI"/>
                <Setter Property="FontSize" Value="13"/>
            </Style>

            <Style TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            </Style>

            <Style x:Key="MutedText" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            </Style>

            <Style TargetType="Button">
                <Setter Property="Background" Value="{DynamicResource BgInput}"/>
                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="14,7"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="4">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Margin="{TemplateBinding Padding}"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Opacity" Value="0.85"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.4"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                <Setter Property="Background" Value="{DynamicResource AccentBlue}"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
            </Style>

            <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                <Setter Property="Background" Value="{DynamicResource DangerRed}"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
            </Style>

            <Style TargetType="TextBox">
                <Setter Property="Background" Value="{DynamicResource BgInput}"/>
                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}"/>
                <Setter Property="CaretBrush" Value="{DynamicResource TextPrimary}"/>
                <Setter Property="Padding" Value="6,5"/>
                <Setter Property="BorderThickness" Value="1"/>
            </Style>

            <Style TargetType="PasswordBox">
                <Setter Property="Background" Value="{DynamicResource BgInput}"/>
                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}"/>
                <Setter Property="CaretBrush" Value="{DynamicResource TextPrimary}"/>
                <Setter Property="Padding" Value="6,5"/>
                <Setter Property="BorderThickness" Value="1"/>
            </Style>

            <!-- Same class of bug as the ComboBoxItem fix below, just on the outer control this
                 time: a plain Style with property Setters leaves the default ComboBox
                 ControlTemplate's own "closed box" chrome in place, which renders that one part
                 using system/OS theme colors regardless of our Background/Foreground setters:
                 confirmed live 2026-08-24 on the new timezone dropdown, which rendered completely
                 blank (not just low-contrast). Full ControlTemplate override, same fix shape as
                 ComboBoxItem's below: one Border for the opaque background, a ContentPresenter for
                 the selected item explicitly wired to the ComboBox's own Foreground (the default
                 template's selection-display part doesn't reliably inherit it), a borderless
                 ToggleButton for the drop-down arrow, and a Popup using our already-correct
                 ComboBoxItem template underneath for the open list, no leftover system chrome
                 anywhere in the chain. -->
            <Style TargetType="ComboBox">
                <Setter Property="Background" Value="{DynamicResource BgInput}"/>
                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="8,6"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ComboBox">
                            <Grid>
                                <Border x:Name="MainBorder"
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="4" SnapsToDevicePixels="True"/>
                                <ContentPresenter Margin="{TemplateBinding Padding}"
                                                   HorizontalAlignment="Left" VerticalAlignment="Center"
                                                   IsHitTestVisible="False"
                                                   Content="{TemplateBinding SelectionBoxItem}"
                                                   ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                   ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                                   TextElement.Foreground="{TemplateBinding Foreground}"/>
                                <ToggleButton Background="Transparent" BorderThickness="0" Focusable="False" ClickMode="Press"
                                              IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border Background="Transparent">
                                                <Path Data="M0,0 L4,4 L8,0" Stroke="{DynamicResource TextSecondary}" StrokeThickness="1.5"
                                                      HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            </Border>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>
                                <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True" Focusable="False"
                                       PopupAnimation="None" IsOpen="{TemplateBinding IsDropDownOpen}"
                                       MinWidth="{TemplateBinding ActualWidth}">
                                    <Border Background="{DynamicResource BgInput}" BorderBrush="{DynamicResource BorderSubtle}"
                                            BorderThickness="1" MaxHeight="320">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                                            <ItemsPresenter/>
                                        </ScrollViewer>
                                    </Border>
                                </Popup>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.4"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- The default ComboBoxItem template pulls system/OS theme colors for the dropdown
                 popup, which renders low-contrast (confirmed live 2026-08-23 on the "Previously
                 connected" host list: pale accent highlight, near-white text, hard to read) inside
                 this dark app. A plain Style with property Setters isn't enough to fully fix this:
                 the default template's own hover/selection visuals can still show through
                 underneath, so this replaces the whole ControlTemplate instead - one Border with an
                 explicit opaque background per state, no leftover system chrome at all. -->
            <Style TargetType="ComboBoxItem">
                <Setter Property="Padding" Value="8,6"/>
                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ComboBoxItem">
                            <Border x:Name="ItemBorder" Background="{DynamicResource BgInput}" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                                <ContentPresenter/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsHighlighted" Value="True">
                                    <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource AccentBlue}"/>
                                    <Setter Property="Foreground" Value="White"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource BgPanelAlt}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style TargetType="CheckBox">
                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            </Style>

            <Style TargetType="RadioButton">
                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            </Style>

            <!-- Same class of bug as the ComboBoxItem fix above: give the menu and every item row its
                 own opaque dark background/foreground so the submenu popup can't fall back to
                 unreadable system theme colors. -->
            <Style TargetType="Menu">
                <Setter Property="Background" Value="{DynamicResource BgPanel}"/>
                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            </Style>
            <Style TargetType="MenuItem">
                <Setter Property="Background" Value="{DynamicResource BgPanel}"/>
                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                <Style.Triggers>
                    <Trigger Property="IsHighlighted" Value="True">
                        <Setter Property="Background" Value="{DynamicResource AccentBlue}"/>
                        <!-- Same gap the ComboBoxItem fix above closed: the highlight trigger was
                             only pinning Background, leaving Foreground to whatever the default
                             template's own hover visuals do with it. Pinning both explicitly here
                             too, same reasoning; not yet escalated to a full ControlTemplate
                             override the way ComboBoxItem was, since (unlike ComboBoxItem) no live
                             report has actually shown a contrast problem on Menu/MenuItem. -->
                        <Setter Property="Foreground" Value="White"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style TargetType="ScrollViewer">
                <Setter Property="Background" Value="Transparent"/>
            </Style>

        </ResourceDictionary>
    </Application.Resources>
</Application>
